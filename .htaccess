# 1) Standard-Dokument
DirectoryIndex index.html

# 2) HTTP -> HTTPS (falls nicht per Plesk-Checkbox aktiv)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3) Existierende Dateien/Ordner normal ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4) "Hübsche" URLs unterstützen:
# /foo -> /foo.html (Variante A)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# /foo/bar -> /foo/bar/index.html (Variante B)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)/?$ $1/index.html [L]

# 5) Optionale eigene 404-Seite
ErrorDocument 404 /404.html

# 6) (Optional) Security-Header (kannst du übernehmen, wenn gewünscht)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS nur setzen, wenn ALLE Subdomains HTTPS haben:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
